wd <- "Z:/projects/Climate_Risk_Index/"
library(data.table)
library(tidyverse)
library(haven)
library(tigris)
library(ggrastr)
library(rmapshaper)
library(sf)
library(ggplot2)
library(zipcodeR)
crosswalk <- read.csv("Z:/projects/Climate_Risk_Index/LLMA/Replication_June_2025/Auxillary_data/zip_county_cross.csv")
reg_data <- read_dta("Z:/projects/Climate_Risk_Index/LLMA/Replication_June_2025/Clean_data/reg_data.dta")
load(paste0(wd, "MATIC/data/nonrenewals_senate.RData"))
nonren <- nonren %>%
rename(nonren_var = `Calculated Non-Renewal Rate`) %>%
select(
GeoID, year,
`# of Non-Renewals`,
`Specified End of Year Policies in Force`,
`Recalculated Policies in Force (EOY or Calculated # + Non-Renewals)`,
nonren_var
)
names(nonren)[1] <- "county"
nonren <- nonren %>%
add_count(county, year) %>%       # Add a column `n` with count per group
filter(n == 1) %>%                # Keep only unique (county, year) pairs
select(-n)                        # Clean up
coverageA_df <- fread(paste0(wd, "MATIC/data/46matic_zip_year_CoverageA_wide.csv"))
matic_df <- fread(paste0(wd, "MATIC/data/45matic_zip_year_summary.csv")) %>%
rename(zip = PROPERTY_ZIP) %>%
mutate(zip = as.integer(zip))
matic_df <- full_join(matic_df, reg_data); rm(reg_data)
matic_df <- matic_df[!is.na(matic_df$zip) & !is.na(matic_df$year), ]
nonren <- nonren[!is.na(nonren$county) & !is.na(nonren$year), ]
matic_df <- full_join(matic_df, nonren); rm(nonren)
matic_df$tenure_owner_occupied[is.na(matic_df$tenure_owner_occupied)] <- 0
matic_df$count[is.na(matic_df$count)] <- 0
matic_county_df <- matic_df %>%
group_by(county, year, PROPERTY_STATE) %>%
reframe(
avg_premium = weighted.mean(avg_premium, w = tenure_owner_occupied, na.rm = TRUE),
mean_RESPONSE = weighted.mean(mean_RESPONSE, w = count, na.rm = TRUE),
mean_COVA = weighted.mean(mean_COVA, w = count, na.rm = TRUE),
mean_SUCCESS = weighted.mean(mean_SUCCESS, w = count, na.rm = TRUE),
structure_value = weighted.mean(structure_value, w = tenure_owner_occupied, na.rm = TRUE),
disaster_risk = weighted.mean(disaster_risk, w = tenure_owner_occupied, na.rm = TRUE),
count = sum(count, na.rm = TRUE)
) %>%
group_by(county, PROPERTY_STATE) %>%
mutate(
change_avg_premium = if (any(year == 2019)) avg_premium - avg_premium[year == 2019] else NA_real_,
change_mean_RESPONSE = if (any(year == 2019)) mean_RESPONSE - mean_RESPONSE[year == 2019] else NA_real_,
change_mean_COVA = if (any(year == 2019)) mean_COVA - mean_COVA[year == 2019] else NA_real_,
change_mean_SUCCESS = if (any(year == 2019)) mean_SUCCESS - mean_SUCCESS[year == 2019] else NA_real_,
change_structure_value = if (any(year == 2019)) structure_value - structure_value[year == 2019] else NA_real_,
change_disaster_risk = if (any(year == 2019)) disaster_risk - disaster_risk[year == 2019] else NA_real_
) %>%
ungroup()
matic_zip_df <- matic_df %>%
group_by(county, year, PROPERTY_STATE, zip) %>%
reframe(
avg_premium = weighted.mean(avg_premium, w = tenure_owner_occupied, na.rm = TRUE),
mean_RESPONSE = weighted.mean(mean_RESPONSE, w = count, na.rm = TRUE),
mean_COVA = weighted.mean(mean_COVA, w = count, na.rm = TRUE),
mean_SUCCESS = weighted.mean(mean_SUCCESS, w = count, na.rm = TRUE),
structure_value = weighted.mean(structure_value, w = tenure_owner_occupied, na.rm = TRUE),
disaster_risk = weighted.mean(disaster_risk, w = tenure_owner_occupied, na.rm = TRUE),
count = sum(count, na.rm = TRUE)
) %>%
group_by(county, PROPERTY_STATE, zip) %>%
mutate(
change_avg_premium = if (any(year == 2019)) avg_premium - avg_premium[year == 2019] else NA_real_,
change_mean_RESPONSE = if (any(year == 2019)) mean_RESPONSE - mean_RESPONSE[year == 2019] else NA_real_,
change_mean_COVA = if (any(year == 2019)) mean_COVA - mean_COVA[year == 2019] else NA_real_,
change_mean_SUCCESS = if (any(year == 2019)) mean_SUCCESS - mean_SUCCESS[year == 2019] else NA_real_,
change_structure_value = if (any(year == 2019)) structure_value - structure_value[year == 2019] else NA_real_,
change_disaster_risk = if (any(year == 2019)) disaster_risk - disaster_risk[year == 2019] else NA_real_
) %>%
ungroup()
pdf(paste0(wd, "MATIC/output/47simple_matic_plots.pdf"))
vars_to_plot <- c("avg_premium", "mean_RESPONSE", "mean_COVA", "structure_value", "disaster_risk")
for (v in vars_to_plot) {
