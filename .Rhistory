q_c <- quantile(matic_county_df[[v]], probs = c(0.01, 0.99), na.rm = TRUE)
q_z <- quantile(matic_zip_df[[v]], probs = c(0.01, 0.99), na.rm = TRUE)
# County plot
h_county <- ggplot(
filter(matic_county_df, mean_SUCCESS > 0, year == 2024, .data[[v]] >= q_c[1], .data[[v]] <= q_c[2]),
aes_string(x = v)
) +
geom_histogram() +
labs(title = paste0("County Histogram: ", v, " (winsorized)"),
x = v) +
theme_minimal()
