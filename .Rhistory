zips_sf <- zctas(cb = TRUE, year = 2020, class = "sf") %>%
rename(zip = ZCTA5CE20)
counties_sf <- counties(cb = TRUE, year = 2020, class = "sf") %>%
mutate(county_fips = GEOID)
years <- 2019:2024
pdf(paste0(wd, "MATIC/output/47matic_COVA_annual_maps.pdf"))
for (yr in years) {
message("Mapping year: ", yr)
# ---------------- ZIP-LEVEL MAP ----------------
zip_map_data <- coverageA_df %>%
filter(level == "zip", year == yr) %>%
mutate(zip = sprintf("%05d", PROPERTY_ZIP)) %>%
select(zip, median)
zip_sf <- left_join(zips_sf, zip_map_data, by = "zip")
p_zip <- ggplot(filter(zip_sf, !is.na(median), median < 1e6)) +
geom_sf(aes(fill = median), color = NA) +
scale_fill_viridis_c(option = "magma", na.value = "grey90") +
labs(title = paste("Median Coverage A by ZIP (", yr, ")", sep = ""),
fill = "Coverage A") +
theme_minimal()
print(p_zip)
# ---------------- COUNTY-LEVEL MAP ----------------
county_map_data <- coverageA_df %>%
filter(level == "county", year == yr) %>%
mutate(county_fips = sprintf("%05d", county_fips)) %>%
select(county_fips, median)
county_sf <- left_join(counties_sf, county_map_data, by = "county_fips")
p_county <- ggplot(filter(county_sf, !is.na(median), median < 1e6)) +
geom_sf(aes(fill = median), color = NA) +
scale_fill_viridis_c(option = "magma", na.value = "grey90") +
labs(title = paste("Median Coverage A by County (", yr, ")", sep = ""),
fill = "Coverage A") +
theme_minimal()
print(p_county)
}
