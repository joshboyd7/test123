mean_COVA >= q_c_y[1], mean_COVA <= q_c_y[2]),
aes_string(x = v, y = "mean_COVA")
) +
geom_point(alpha = 0.3) +
geom_smooth(method = "lm", se = FALSE, color = "blue") +
labs(title = paste("County-level:", v, "vs mean_COVA (winsorized)"),
x = v, y = "mean_COVA") +
theme_minimal()
print(p_county)
# ZIP histogram
h_zip <- ggplot(
filter(matic_zip_df, year == 2024,
.data[[v]] >= q_z_v[1], .data[[v]] <= q_z_v[2],
mean_COVA >= q_z_y[1], mean_COVA <= q_z_y[2]),
aes_string(x = v)
) +
geom_histogram() +
labs(title = paste0("ZIP Histogram: ", v, " (winsorized)"),
x = v) +
theme_minimal()
print(h_zip)
# ZIP scatter
p_zip <- ggplot(
filter(matic_zip_df, year == 2024,
.data[[v]] >= q_z_v[1], .data[[v]] <= q_z_v[2],
mean_COVA >= q_z_y[1], mean_COVA <= q_z_y[2]),
aes_string(x = v, y = "mean_COVA")
) +
geom_point(alpha = 0.3) +
geom_smooth(method = "lm", se = FALSE, color = "blue") +
labs(title = paste("ZIP-level:", v, "vs mean_COVA (winsorized)"),
x = v, y = "mean_COVA") +
theme_minimal()
print(p_zip)
}
